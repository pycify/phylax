{
  "environment": "development",
  "server": {
    "addr": ":8080"
  },
  "storage": {
    "driver": "postgres",
    "database_url": "postgresql://postgres:postgres@127.0.0.1:5432/phylax?sslmode=disable"
  },
  "redis": {
    "url": "redis://localhost:6379"
  },
  "mail": {
    "driver": "log",
    "from_name": "Phylax",
    "from_email": "no-reply@phylax.local"
  },
  "token": {
    "issuer": "phylax-development",
    "secret": "dev-secret-change-me-32-bytes-minimum",
    "ttl_seconds": 900
  },
  "challenges": {
    "ttl_seconds": 300
  },
  "apps": [
    {
      "id": "demo",
      "name": "Demo App",
      "android": {
        "enabled": true,
        "provider": "play_integrity",
        "package_name": "com.example.demo",
        "allow_mock_verification": true,
        "require_play_recognized": true,
        "required_device_integrity": [
          "MEETS_DEVICE_INTEGRITY"
        ]
      },
      "apple": {
        "enabled": true,
        "provider": "app_attest",
        "bundle_id": "com.example.demo",
        "team_id": "ABCDE12345",
        "environment": "development",
        "allow_mock_verification": true
      },
      "firebase": {
        "enabled": false,
        "project_id": ""
      }
    }
  ]
}
