{
  "environment": "staging",
  "server": {
    "addr": ":8080"
  },
  "storage": {
    "driver": "postgres",
    "database_url": ""
  },
  "redis": {
    "url": ""
  },
  "mail": {
    "driver": "smtp",
    "from_name": "Phylax",
    "from_email": "no-reply@phylax.dev"
  },
  "token": {
    "issuer": "phylax-staging",
    "secret": "set-PHYLAX_TOKEN_SECRET-on-render",
    "ttl_seconds": 900
  },
  "challenges": {
    "ttl_seconds": 300
  },
  "apps": [
    {
      "id": "nexbox-staging",
      "name": "NexBox Staging",
      "android": {
        "enabled": true,
        "provider": "play_integrity",
        "package_name": "com.nexbox.app.staging",
        "service_account_json_env": "GOOGLE_PLAY_SERVICE_ACCOUNT_JSON",
        "require_play_recognized": true,
        "required_device_integrity": ["MEETS_DEVICE_INTEGRITY"]
      },
      "apple": {
        "enabled": true,
        "provider": "app_attest",
        "bundle_id": "com.nexbox.app.staging",
        "team_id": "SET_TEAM_ID",
        "environment": "development"
      },
      "firebase": {
        "enabled": false,
        "project_id": ""
      }
    }
  ]
}
