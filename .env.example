PHYLAX_ENV=
PHYLAX_ADDR=
PHYLAX_STORAGE_DRIVER=
PHYLAX_TOKEN_SECRET=
PHYLAX_CREDENTIAL_ENCRYPTION_KEY=

# Render sets PORT automatically. Set DATABASE_URL for staging/production Postgres.
DATABASE_URL=
REDIS_URL=

# Mail. Use MAIL_DRIVER=log locally and smtp in staging/production.
MAIL_DRIVER=log
MAIL_FROM_NAME=Phylax
MAIL_FROM_EMAIL=no-reply@phylax.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Provider credentials.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
FIREBASE_CREDENTIALS_JSON=
