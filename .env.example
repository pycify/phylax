# Required.
PHYLAX_ENV=
DATABASE_URL=
PHYLAX_TOKEN_SECRET=
PHYLAX_CREDENTIAL_ENCRYPTION_KEY=

# Optional overrides.
PHYLAX_ADDR=
PHYLAX_STORAGE_DRIVER=
PHYLAX_TOKEN_ISSUER=
PHYLAX_TOKEN_TTL_SECONDS=
PHYLAX_CHALLENGE_TTL_SECONDS=
REDIS_URL=

# Mail. Use MAIL_DRIVER=log locally and smtp in staging/production.
MAIL_DRIVER=log
MAIL_FROM_NAME=Phylax
MAIL_FROM_EMAIL=no-reply@phylax.local

# Required only when MAIL_DRIVER=smtp.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Provider credentials.
FIREBASE_CREDENTIALS_JSON=
